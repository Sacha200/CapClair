# CapClair — back/ : copier en .env (ignoré par Git) et renseigner.
# Toutes les variables obligatoires doivent être présentes : sinon l'application
# refuse de démarrer (voir src/env.ts) — US-8.4.
#
# Aucune valeur réelle ici. Les identifiants de dev ci-dessous ne servent qu'en local.

# --- Exécution ---
NODE_ENV=
PORT=

# --- Base de données ---
# Port 5434 en local : voir docker-compose.yml (5432 = Postgres natif, 5433 = sonarqube-db).
DATABASE_URL=
# Base jetable pour les tests d'intégration. DOIT être distincte de DATABASE_URL.
TEST_DATABASE_URL=

# --- Redis (file BullMQ + option store rate-limit) ---
REDIS_URL=

# --- URL publique du front (liens dans les e-mails, ex. réinitialisation) ---
APP_BASE_URL=

# --- Session ---
SESSION_COOKIE_NAME=
SESSION_TTL_HOURS=
# Laisser vide pour un cookie host-only (recommandé, origine publique unique).
COOKIE_DOMAIN=
# true en prod (HTTPS). false uniquement en dev local.
COOKIE_SECURE=

# --- Réinitialisation de mot de passe ---
PASSWORD_RESET_TTL_MINUTES=

# --- Hachage argon2id ---
ARGON2_MEMORY_KIB=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# --- Anti-énumération : durée minimale constante des réponses auth ---
AUTH_FIXED_DELAY_MS=
AUTH_FIXED_DELAY_JITTER_MS=

# --- Stockage & import de documents (US-2.1) ---
# Chemin relatif (résolu depuis la racine de back/) ou absolu. Hors racine web.
STORAGE_DIR=
# Taille maximale d'un import, en octets (10 Mo = 10485760).
MAX_UPLOAD_BYTES=

# --- Limitation de débit (US-8.1) — tous les seuils par variable d'environnement ---
# Plafond global appliqué à toutes les routes (garde-fou anti-abus).
RATE_LIMIT_GLOBAL_MAX=
RATE_LIMIT_GLOBAL_WINDOW=
# Routes sensibles (resserrent le plafond global). MAX = nb de requêtes / WINDOW / IP.
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW=
RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_REGISTER_WINDOW=
RATE_LIMIT_FORGOT_MAX=
RATE_LIMIT_FORGOT_WINDOW=
RATE_LIMIT_RESET_MAX=
RATE_LIMIT_RESET_WINDOW=
# Import de documents (E2) et analyse IA (E3) — routes à venir, seuils déjà réglables.
RATE_LIMIT_IMPORT_MAX=
RATE_LIMIT_IMPORT_WINDOW=
RATE_LIMIT_ANALYSIS_MAX=
RATE_LIMIT_ANALYSIS_WINDOW=
# true = store Redis (multi-instance) ; false = store mémoire (mono-instance).
RATE_LIMIT_REDIS=
# true derrière un reverse-proxy (X-Forwarded-For fiable).
TRUST_PROXY=

# --- CORS (dev uniquement, si le front n'est pas servi via le rewrite Next) ---
CORS_ORIGIN=

# --- E-mail ---
# console = journalise l'e-mail au lieu de l'envoyer (dev). smtp = envoi réel.
MAIL_TRANSPORT=
MAIL_FROM=

# --- pgAdmin (profil docker compose "app", optionnel) ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=
