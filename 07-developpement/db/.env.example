# Copier en .env (ignoré par Git) et adapter si besoin.
#
# Port 5434 : voir docker-compose.yml — 5432 est pris par le PostgreSQL natif
# et 5433 par le conteneur sonarqube-db.
# Ces identifiants ne valent que pour le développement local.
DATABASE_URL="postgresql://capclair:capclair_dev@localhost:5434/capclair?schema=public"
