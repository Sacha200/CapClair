{
  "name": "capclair-db",
  "version": "0.1.0",
  "private": true,
  "description": "Schéma Prisma et migrations de CapClair. À rattacher au dépôt back lors de son amorçage.",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "pgadmin": "docker compose --profile app up -d",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio"
  },
  "devDependencies": {
    "dotenv": "^17.2.4",
    "prisma": "^7.9.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  }
}
