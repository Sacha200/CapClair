# CapClair — production. Copier en .env.prod sur le serveur (jamais commité).
# Aucune valeur réelle ici (US-8.4).
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ RÈGLE À NE PAS ENFREINDRE : une variable présente mais VIDE n'est PAS   │
# │ équivalente à une variable absente.                                     │
# │                                                                         │
# │ `env_file` de Compose injecte `FOO=` comme la chaîne vide, et les       │
# │ `.default()` de back/src/env.ts ne s'appliquent qu'à `undefined`. Une   │
# │ chaîne vide échoue donc à la validation : `z.string().min(1)` refuse "", │
# │ `z.coerce.number()` transforme "" en 0 qui échoue `.positive()`, et un  │
# │ `z.enum` refuse "". Le back sort alors en listant les erreurs, et       │
# │ `deploy.sh` reste bloqué sur `up -d --wait`.                            │
# │                                                                         │
# │ D'où la forme de ce fichier : ce qui est OBLIGATOIRE est en clair, tout │
# │ ce qui a un défaut est COMMENTÉ. Ne décommente une ligne que pour lui   │
# │ donner une vraie valeur — jamais pour la laisser vide.                  │
# └──────────────────────────────────────────────────────────────────────────┘
#
# Rappel : docker-compose.prod.yml force déjà NODE_ENV, PORT, TRUST_PROXY,
# COOKIE_SECURE et RATE_LIMIT_REDIS. Ne pas les redéclarer ici.

# ============================================================================
# OBLIGATOIRE — lu par docker-compose.prod.yml (interpolation ${...})
# ============================================================================

# Domaine public, lu par Caddy pour le certificat Let's Encrypt. Doit pointer
# sur l'IP du serveur par un enregistrement DNS A AVANT le premier démarrage.
PUBLIC_DOMAIN=

# Initialisent le conteneur `db`. Doivent être cohérents avec DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ============================================================================
# OBLIGATOIRE — sans défaut dans back/src/env.ts, le back refuse de démarrer
# ============================================================================

# Hôte `db` sur le port 5432 (réseau interne de Compose), jamais localhost :
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=

REDIS_URL=redis://redis:6379

# Liens dans les e-mails. Doit valoir https://<PUBLIC_DOMAIN>
APP_BASE_URL=

ANTHROPIC_API_KEY=

# ============================================================================
# OPTIONNEL — tout ce qui suit a un défaut fonctionnel dans back/src/env.ts.
# Laisser commenté = utiliser le défaut indiqué. Décommenter = fournir une
# valeur non vide.
# ============================================================================

# --- Modèle d'analyse ---
#ANTHROPIC_MODEL=claude-sonnet-5

# --- Session ---
# Si tu décommentes SESSION_COOKIE_NAME, docker-compose.prod.yml le transmet
# aussi au service `front` : le middleware et le back doivent chercher le même
# cookie, sinon toute route protégée renvoie vers /connexion.
#SESSION_COOKIE_NAME=capclair_session
#SESSION_TTL_HOURS=168
# Laisser vide OU commenté : cookie host-only, origine publique unique
# (ADR-005). C'est la seule variable pour laquelle le vide est traité comme
# l'absence, via le préprocesseur `optional()` de env.ts.
COOKIE_DOMAIN=

# --- Réinitialisation de mot de passe ---
#PASSWORD_RESET_TTL_MINUTES=60

# --- Anti-énumération : durée minimale constante des réponses auth ---
#AUTH_FIXED_DELAY_MS=350
#AUTH_FIXED_DELAY_JITTER_MS=40

# --- Hachage argon2id ---
# Les défauts sont les valeurs de production (65536 KiB, 3 passes). Ne les
# baisser que sur une machine contrainte, et jamais aux valeurs des tests.
#ARGON2_MEMORY_KIB=65536
#ARGON2_TIME_COST=3
#ARGON2_PARALLELISM=1

# --- Stockage & import ---
# Le défaut de env.ts est le chemin relatif `storage`, résolu depuis /app/back,
# soit exactement le point de montage du volume. Décommenter n'est utile que
# pour déplacer le volume.
#STORAGE_DIR=/app/back/storage
#PDF_MAX_PAGES=10
#PDF_EXTRACT_TIMEOUT_MS=5000

# --- Limitation de débit (US-8.1) ---
#RATE_LIMIT_GLOBAL_MAX=1000
#RATE_LIMIT_GLOBAL_WINDOW=1 minute
#RATE_LIMIT_LOGIN_MAX=5
#RATE_LIMIT_LOGIN_WINDOW=15 minutes
#RATE_LIMIT_REGISTER_MAX=10
#RATE_LIMIT_REGISTER_WINDOW=15 minutes
#RATE_LIMIT_FORGOT_MAX=5
#RATE_LIMIT_FORGOT_WINDOW=15 minutes
#RATE_LIMIT_RESET_MAX=10
#RATE_LIMIT_RESET_WINDOW=15 minutes
#RATE_LIMIT_IMPORT_MAX=20
#RATE_LIMIT_IMPORT_WINDOW=1 minute
#RATE_LIMIT_ANALYSIS_MAX=10
#RATE_LIMIT_ANALYSIS_WINDOW=1 minute

# --- E-mail ---
# `console` journalise l'e-mail au lieu de l'envoyer. Passer à `smtp` suppose
# un transport configuré ; tant que ce n'est pas le cas, laisser le défaut.
#MAIL_TRANSPORT=console
#MAIL_FROM=CapClair <no-reply@capclair.local>

# ============================================================================
# Variables des tâches suivantes du sprint. Elles n'existent pas encore dans
# back/src/env.ts : les renseigner maintenant n'aurait aucun effet, et les
# laisser en clair et vides poserait le problème décrit en tête de fichier dès
# qu'elles y seront ajoutées. Commentées jusqu'à leur tâche.
# ============================================================================
# T3 — observabilité
#SENTRY_DSN=
# T4 — durcissement de l'exploitation
#ANTHROPIC_TIMEOUT_MS=
#ANTHROPIC_MAX_RETRIES=
#ANALYSIS_CACHE_TTL_DAYS=
#ANALYSIS_DAILY_QUOTA=
# T6 — réconciliateur des analyses orphelines
#RECONCILE_STALE_MINUTES=
