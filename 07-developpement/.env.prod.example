# CapClair — production. Copier en .env.prod sur le serveur (jamais commité).
# Aucune valeur réelle ici (US-8.4). Toute variable obligatoire absente fait
# échouer le démarrage du back avec la liste complète des manques.
#
# Rappel : docker-compose.prod.yml force déjà NODE_ENV, PORT, TRUST_PROXY,
# COOKIE_SECURE et RATE_LIMIT_REDIS — ne pas les contredire ici.

# --- Domaine public (lu par Caddy pour le certificat Let's Encrypt) ---
# Doit pointer sur l'IP du serveur par un enregistrement DNS A avant le premier
# démarrage, sinon l'émission du certificat échoue.
PUBLIC_DOMAIN=

# --- Base de données ---
# Les trois POSTGRES_* initialisent le conteneur db ; DATABASE_URL doit être
# cohérente avec elles et viser l'hôte `db` sur le réseau interne, port 5432 :
#   postgresql://<user>:<password>@db:5432/<base>?schema=public
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Redis (file BullMQ + store du rate limit) ---
REDIS_URL=redis://redis:6379

# --- URL publique du front (liens dans les e-mails) ---
# Doit valoir https://<PUBLIC_DOMAIN>
APP_BASE_URL=

# --- Session ---
SESSION_COOKIE_NAME=
SESSION_TTL_HOURS=
# Laisser vide : cookie host-only, origine publique unique (ADR-005).
COOKIE_DOMAIN=

# --- Réinitialisation de mot de passe ---
PASSWORD_RESET_TTL_MINUTES=

# --- Hachage argon2id (valeurs de production, pas celles des tests) ---
ARGON2_MEMORY_KIB=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# --- Anti-énumération ---
AUTH_FIXED_DELAY_MS=
AUTH_FIXED_DELAY_JITTER_MS=

# --- Stockage & import ---
# Doit correspondre au point de montage du volume `storage` du compose.
STORAGE_DIR=/app/back/storage
PDF_MAX_PAGES=
PDF_EXTRACT_TIMEOUT_MS=

# --- Limitation de débit ---
RATE_LIMIT_GLOBAL_MAX=
RATE_LIMIT_GLOBAL_WINDOW=
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW=
RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_REGISTER_WINDOW=
RATE_LIMIT_FORGOT_MAX=
RATE_LIMIT_FORGOT_WINDOW=
RATE_LIMIT_RESET_MAX=
RATE_LIMIT_RESET_WINDOW=
RATE_LIMIT_IMPORT_MAX=
RATE_LIMIT_IMPORT_WINDOW=
RATE_LIMIT_ANALYSIS_MAX=
RATE_LIMIT_ANALYSIS_WINDOW=

# --- E-mail ---
MAIL_TRANSPORT=
MAIL_FROM=

# --- Analyse IA ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ============================================================================
# Variables des tâches suivantes du sprint. Déclarées ici pour que le gabarit
# soit complet à la fin du sprint ; elles n'existent pas encore dans
# back/src/env.ts, donc les renseigner maintenant n'a aucun effet.
# ============================================================================
# T3 — observabilité
SENTRY_DSN=
# T4 — durcissement de l'exploitation
ANTHROPIC_TIMEOUT_MS=
ANTHROPIC_MAX_RETRIES=
ANALYSIS_CACHE_TTL_DAYS=
ANALYSIS_DAILY_QUOTA=
# T6 — réconciliateur des analyses orphelines
RECONCILE_STALE_MINUTES=
