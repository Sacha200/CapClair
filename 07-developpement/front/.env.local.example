# CapClair — front/ : copier en .env.local (ignoré par Git).

# URL publique du front (liens, métadonnées).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origine du back pour les appels côté serveur (RSC, middleware).
# En dev, le navigateur passe par le rewrite /api/back/* → cette origine.
BACK_ORIGIN=http://localhost:3001

# Doit correspondre à SESSION_COOKIE_NAME du back.
SESSION_COOKIE_NAME=capclair_session
